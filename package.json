{
  "name": "milliy-uz",
  "version": "1.0.0",
  "private": true,
  "description": "Milliy.uz — O'zbekiston xizmatlar katalogi",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/src/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/src/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env server/scripts/seed.js",
    "hash-password": "node server/scripts/hash-password.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide": "^1.61.0",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
