# --- Server ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_PATH=data/milliy.db
# Comma-separated list of allowed origins; leave empty for same-origin only.
CORS_ORIGIN=
# Set to true when running behind a reverse proxy (nginx, Caddy, a load balancer).
TRUST_PROXY=false
# Serve the built frontend from dist/ (defaults to true in production).
SERVE_STATIC=

# --- Admin authentication (required in production) ---
ADMIN_USERNAME=admin
# Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
SESSION_TTL_SECONDS=28800
# Defaults to true in production; requires HTTPS.
COOKIE_SECURE=

# --- Chat assistant (optional) ---
# One of: none, gemini, openai, deepseek
AI_PROVIDER=none
AI_MODEL=
AI_TIMEOUT_MS=15000
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
